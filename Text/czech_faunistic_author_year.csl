<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" demote-non-dropping-particle="sort-only">
  <info>
    <title>Entomologické listy (ZEL, 2025)</title>
    <id>https://www.entolisty.cz/csl/zel</id>
    <link href="https://www.entolisty.cz/pokyny-pro-autory/" rel="self"/>
    <author>Jonáš Gaigr</author>
    <category citation-format="author-date"/>
    <updated>2025-10-27</updated>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="first" text-case="uppercase" delimiter=", " and="symbol" initialize-with="."/>
    </names>
  </macro>

  <macro name="issued-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="title">
    <text variable="title" suffix="."/>
  </macro>

  <macro name="container">
    <text variable="container-title" font-style="italic"/>
  </macro>

  <macro name="access">
    <group>
      <text value="Dostupné z: "/>
      <text variable="URL"/>
      <group prefix=" (" suffix=").">
        <text term="accessed" text-case="lowercase" value="cit."/>
        <date variable="accessed" prefix=" ">
          <date-part name="day" suffix=". "/>
          <date-part name="month" suffix=". "/>
          <date-part name="year"/>
        </date>
      </group>
    </group>
  </macro>

  <citation et-al-min="3" et-al-use-first="1" collapse="year">
    <sort>
      <key variable="issued"/>
      <key variable="author"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author"/>
        <text macro="issued-year"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" et-al-min="4" et-al-use-first="3" line-spacing="2" entry-spacing="1">
    <sort>
      <key macro="author"/>
      <key macro="issued-year"/>
    </sort>
    <layout>
      <group delimiter=" ">
        <text macro="author" suffix="."/>
        <text macro="issued-year" prefix=" (" suffix=")."/>
        <text macro="title" suffix=" "/>
        <text macro="container" suffix=" "/>
        <group delimiter=", ">
          <text variable="volume"/>
          <text variable="page"/>
        </group>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
